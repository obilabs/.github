# ObiLabs baseline .gitignore - extend per project, do not remove these entries.

# Secrets and local environment (commit a sanitized .env.example instead)
.env
.env.*
!.env.example
!.env.sample
*.pem
*.p12
*service-account*.json
credentials.json

# Dependencies and build output
node_modules/
dist/
build/
coverage/

# Local R&D log (backed up off-machine, never committed)
.rd_log/

# Per-developer tool settings
.claude/settings.local.json

# OS / editor noise
.DS_Store
Thumbs.db
