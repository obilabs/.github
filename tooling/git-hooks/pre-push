#!/bin/sh
# ObiLabs hygiene pre-push hook.
# Blocks direct pushes to main/master, and pushes of commits whose author or
# committer is a personal webmail address or whose message carries an AI
# co-author trailer. Then runs the repo's own pre-push hook with the same stdin.
# Canonical source: obilabs/.github, tooling/git-hooks/.

HYG_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
if [ ! -f "$HYG_DIR/hygiene-lib.sh" ]; then
  echo "hygiene: hygiene-lib.sh is missing next to $0; reinstall the hooks (tooling/git-hooks/install.sh)." >&2
  exit 1
fi
. "$HYG_DIR/hygiene-lib.sh"

remote_name=$1
remote_url=$2
input=$(cat)
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue

  case $remote_ref in
    refs/heads/main | refs/heads/master)
      if [ "${OBILABS_ALLOW_MAIN_PUSH:-}" = "1" ]; then
        hyg_err "hygiene: WARNING - OBILABS_ALLOW_MAIN_PUSH=1, allowing push to $remote_ref."
      else
        hyg_err "hygiene: direct push to $remote_ref refused. Land work on main through a pull request:"
        hyg_err "    git push -u origin <feature-branch> && gh pr create"
        hyg_err "  Deliberate exception (e.g. bootstrapping a new repo): OBILABS_ALLOW_MAIN_PUSH=1 git push ..."
        fail=1
      fi
      ;;
  esac

  case $local_sha in *[!0]*) ;; *) continue ;; esac # branch deletion
  hyg_skip_requested && continue

  case $remote_sha in
    *[!0]*)
      if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        set -- "$remote_sha..$local_sha"
      else
        set -- "$local_sha" --not --remotes
      fi
      ;;
    *) set -- "$local_sha" --not --remotes ;; # new branch: only commits no remote has
  esac

  ids=$(hyg_bad_identity_commits "$@")
  if [ -n "$ids" ]; then
    hyg_err "hygiene: commits for $remote_ref use a personal webmail identity:"
    hyg_err "$ids"
    hyg_err "  Fix config (git config user.email <noreply>) then rewrite, e.g.:"
    hyg_err "    git rebase -r <base> --exec 'git commit --amend --no-edit --reset-author'"
    fail=1
  fi

  trailers=$(hyg_ai_trailer_commits "$@")
  if [ -n "$trailers" ]; then
    hyg_err "hygiene: commits for $remote_ref carry an AI co-author/attribution line:"
    hyg_err "$trailers"
    hyg_err "  Reword them (git rebase -i <base>, 'reword') and delete the line."
    fail=1
  fi
done <<EOF
$input
EOF

hyg_skip_requested && hyg_warn_skip pre-push

if [ "$fail" -ne 0 ]; then
  hyg_err "hygiene: push blocked."
  exit 1
fi

if [ -n "$input" ]; then printf '%s\n' "$input"; fi | hyg_chain pre-push "$remote_name" "$remote_url"
